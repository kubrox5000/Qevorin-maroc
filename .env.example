# ==============================================================================
# QEVORIN PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. DATABASE CONFIGURATION (REQUIRED)
# The pooled connection string from Neon PostgreSQL console (eu/us regions with -pooler)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-db-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional direct connection string for administrative migrations
DIRECT_URL="postgresql://neondb_owner:your_password@ep-your-db.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional pool size limit (default: 3 in serverless, 10 in long-running container)
DB_POOL_MAX="3"

# 2. RUNTIME ENVIRONMENT (REQUIRED)
NODE_ENV="production"

# 3. ADMIN AUTHENTICATION & SECURITY (REQUIRED)
# The production password for logging into the /#admin portal (Rotate before production!)
ADMIN_PASSWORD="your_strong_rotated_admin_password_2026"

# Cryptographic secret used for HMAC-SHA256 signature of admin session tokens
ADMIN_SECRET_KEY="your_long_random_admin_session_secret_min_32_chars"

# Cryptographic key for AES-256-GCM encryption of sensitive credentials at rest (e.g., courier keys)
# If omitted, falls back to ADMIN_SECRET_KEY
ENCRYPTION_KEY="your_dedicated_aes256_encryption_key_at_rest"

# 4. OPTIONAL INTEGRATIONS
# Google Gemini API key (optional for smart audit features)
GEMINI_API_KEY=""

# AliExpress Open Platform credentials (optional for automated catalog audit)
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""

# Production hosted domain URL
APP_URL="https://qevorin.ma"
